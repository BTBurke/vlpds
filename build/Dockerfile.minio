# MinIO no longer publishes container images; build the server and mc from source.
FROM golang:1.25-bookworm AS build
ENV CGO_ENABLED=0
RUN go install github.com/minio/minio@latest && go install github.com/minio/mc@latest

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /go/bin/minio /go/bin/mc /usr/local/bin/
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
