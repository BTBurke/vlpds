+async fn list_repos_all(args: &Args, limit: usize, json_out: &str) -> anyhow::Result<()> {
+    let c = client();
+    let t = Instant::now();
+    let (mut repos, mut pages, mut bytes) = (0u64, 0u64, 0u64);
+    let mut page_lat = hist();
+    let mut cursor: Option<String> = None;
+    loop {
+        let mut q = vec![("limit", limit.to_string())];
+        if let Some(cu) = &cursor {
+            q.push(("cursor", cu.clone()));
+        }
+        let t0 = Instant::now();
+        let resp = c.get(format!("{}/xrpc/com.atproto.sync.listRepos", args.host)).query(&q).send().await?;
+        anyhow::ensure!(resp.status().is_success(), "listRepos {}", resp.status());
+        let b = resp.bytes().await?;
+        let _ = page_lat.record(t0.elapsed().as_micros().max(1) as u64);
+        bytes += b.len() as u64;
+        let v: serde_json::Value = serde_json::from_slice(&b)?;
+        let n = v["repos"].as_array().map(|a| a.len()).unwrap_or(0) as u64;
+        repos += n;
+        pages += 1;
+        if pages % 1000 == 0 {
+            eprintln!("listRepos: {repos} repos, {pages} pages ({:.0} repos/s)", repos as f64 / t.elapsed().as_secs_f64());
+        }
+        match v["cursor"].as_str() {
+            Some(cu) if n > 0 => cursor = Some(cu.to_string()),
+            _ => break,
+        }
+    }
+    let secs = t.elapsed().as_secs_f64();
+    let q = |p: f64| page_lat.value_at_quantile(p) as f64 / 1000.0;
+    let out = json!({"method": "listRepos-enumerate", "limit": limit, "repos": repos, "pages": pages, "secs": secs,
+        "repos_per_s": repos as f64 / secs, "mb": bytes as f64 / 1e6, "page_p50_ms": q(0.5), "page_p99_ms": q(0.99), "page_max_ms": page_lat.max() as f64 / 1000.0});
+    println!("{out}");
+    if !json_out.is_empty() {
+        std::fs::write(json_out, out.to_string())?;
+    }
+    Ok(())
+}
