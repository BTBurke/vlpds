{
  "lexicon": 1,
  "id": "dev.example.boards.getPosts",
  "defs": {
    "main": {
      "type": "query",
      "description": "A page of a board's posts. Viewers authenticate with a space credential for the board (Authorization: Atproto-Space, audience = this appview's DID).",
      "parameters": { "type": "params", "required": ["board"], "properties": { "board": { "type": "string", "format": "uri" }, "sort": { "type": "string", "knownValues": ["hot", "new", "top"], "default": "hot" }, "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 25 }, "cursor": { "type": "string" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["posts"], "properties": { "posts": { "type": "array", "items": { "type": "ref", "ref": "dev.example.boards.defs#postView" } }, "cursor": { "type": "string" } } } },
      "errors": [{ "name": "BoardNotFound" }, { "name": "AuthRequired" }]
    }
  }
}
