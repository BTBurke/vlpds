{
  "lexicon": 1,
  "id": "dev.example.boards.defs",
  "defs": {
    "boardView": {
      "type": "object",
      "required": ["uri", "owner", "name", "members", "posts", "comments"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "owner": { "type": "string", "format": "did" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "flairs": { "type": "array", "items": { "type": "string" } },
        "pinned": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "members": { "type": "integer", "description": "Repos the board's space host tracks, less removed members." },
        "posts": { "type": "integer" },
        "comments": { "type": "integer" }
      }
    },
    "postView": {
      "type": "object",
      "required": ["uri", "cid", "author", "title", "score", "ups", "downs", "comments", "createdAt"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "cid": { "type": "string", "format": "cid" },
        "author": { "type": "string", "format": "did" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "flair": { "type": "string" },
        "image": { "type": "ref", "ref": "#imageView" },
        "pinned": { "type": "boolean" },
        "score": { "type": "integer" },
        "ups": { "type": "integer" },
        "downs": { "type": "integer" },
        "comments": { "type": "integer" },
        "createdAt": { "type": "string", "format": "datetime" },
        "editedAt": { "type": "string", "format": "datetime" }
      }
    },
    "imageView": {
      "type": "object",
      "required": ["cid"],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "mimeType": { "type": "string" },
        "alt": { "type": "string" },
        "url": { "type": "string", "description": "dev.example.boards.getImage on this appview." }
      }
    },
    "commentView": {
      "type": "object",
      "required": ["uri", "score", "replies"],
      "properties": {
        "uri": { "type": "string", "format": "uri" },
        "cid": { "type": "string", "format": "cid" },
        "author": { "type": "string", "format": "did" },
        "body": { "type": "string" },
        "deleted": { "type": "boolean", "description": "A placeholder for a missing parent that still has replies." },
        "score": { "type": "integer" },
        "createdAt": { "type": "string", "format": "datetime" },
        "replies": { "type": "array", "items": { "type": "ref", "ref": "#commentView" } }
      }
    }
  }
}
