{
  "lexicon": 1,
  "id": "dev.example.boards.post",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["title", "createdAt"],
        "properties": {
          "title": { "type": "string", "maxLength": 3000, "maxGraphemes": 300 },
          "body": { "type": "string", "maxLength": 40000, "maxGraphemes": 10000 },
          "image": { "type": "ref", "ref": "#image" },
          "flair": { "type": "string", "maxLength": 64, "description": "One of the board's flairs; anything else is ignored." },
          "createdAt": { "type": "string", "format": "datetime" },
          "editedAt": { "type": "string", "format": "datetime" }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["blob"],
      "properties": {
        "blob": { "type": "blob", "accept": ["image/*"], "maxSize": 2000000 },
        "alt": { "type": "string", "maxLength": 10000, "maxGraphemes": 1000 }
      }
    }
  }
}
