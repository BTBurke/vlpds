{
  "lexicon": 1,
  "id": "dev.example.boards.getBoard",
  "defs": {
    "main": {
      "type": "query",
      "description": "A board's settings and counts. Viewers authenticate with a space credential for the board (Authorization: Atproto-Space, audience = this appview's DID).",
      "parameters": { "type": "params", "required": ["board"], "properties": { "board": { "type": "string", "format": "uri" } } },
      "output": { "encoding": "application/json", "schema": { "type": "ref", "ref": "dev.example.boards.defs#boardView" } },
      "errors": [{ "name": "BoardNotFound" }, { "name": "AuthRequired" }]
    }
  }
}
