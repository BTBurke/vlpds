{
  "lexicon": 1,
  "id": "dev.example.boards.getPostThread",
  "defs": {
    "main": {
      "type": "query",
      "description": "A post and its comment tree (comments best first). Viewers authenticate with a space credential for the board (Authorization: Atproto-Space, audience = this appview's DID).",
      "parameters": { "type": "params", "required": ["uri"], "properties": { "uri": { "type": "string", "format": "uri" } } },
      "output": { "encoding": "application/json", "schema": { "type": "object", "required": ["post", "replies"], "properties": { "post": { "type": "ref", "ref": "dev.example.boards.defs#postView" }, "replies": { "type": "array", "items": { "type": "ref", "ref": "dev.example.boards.defs#commentView" } } } } },
      "errors": [{ "name": "BoardNotFound" }, { "name": "AuthRequired" }]
    }
  }
}
